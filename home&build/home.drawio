    <mxCell id="title" value="米家全屋智能装修避坑指南" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
      <mxGeometry x="220" y="10" width="600" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="subtitle" value="核心价值：无感适配生活 | 预埋决定上限 | 从简到繁、逐步优化" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#888888;" vertex="1" parent="1">
      <mxGeometry x="260" y="52" width="520" height="18" as="geometry"/>
    </mxCell>

    <!-- ========== Section 1 ========== -->
    <mxCell id="s1" value="一、前期规划与水电改造" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;arcSize=15;" vertex="1" parent="1">
      <mxGeometry x="20" y="90" width="320" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="s1sub" value="地基工程，疏漏几乎无法后期弥补" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#6c8ebf;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="20" y="134" width="320" height="16" as="geometry"/>
    </mxCell>

    <mxCell id="s1a" value="[电路预埋]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
      <mxGeometry x="20" y="160" width="320" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s1a1" value="- 所有开关底盒必须预留零线&#xa;- 单控布线为主，无线开关补双控&#xa;- 86型底盒 深度&gt;=4cm(建议5cm)&#xa;- 窗帘电机/马桶/智能镜预留插座&#xa;- 吊顶预留零火线(吸顶式传感器)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b0c4de;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="20" y="192" width="320" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="s1b" value="[网络布线]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
      <mxGeometry x="20" y="306" width="320" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s1b1" value="- 全屋铺CAT.6 每根预留1m冗余&#xa;- 电视墙2根，每房间&gt;=1网口&#xa;- 大户型AC+AP / 中小有线Mesh&#xa;- 80平以下单台路由器即可" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b0c4de;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="20" y="338" width="320" height="84" as="geometry"/>
    </mxCell>

    <mxCell id="s1c" value="[插座与木工]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
      <mxGeometry x="20" y="436" width="320" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s1c1" value="- 插座宁多勿少(每面墙预留)&#xa;- 窗帘盒: 单轨&gt;=15cm 双轨&gt;=20cm&#xa;- 拒绝罗马杆! 灯带预埋三芯线&#xa;- 网关放客厅中心(120平1个)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b0c4de;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="20" y="468" width="320" height="84" as="geometry"/>
    </mxCell>

    <!-- ========== Section 2 ========== -->
    <mxCell id="s2" value="二、设备选型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a2e;arcSize=15;" vertex="1" parent="1">
      <mxGeometry x="370" y="90" width="300" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="s2sub" value="协议统一、适配场景、拒绝鸡肋" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#82b366;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="370" y="134" width="300" height="16" as="geometry"/>
    </mxCell>

    <mxCell id="s2a" value="[核心设备]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#eaf5ea;strokeColor=#82b366;align=center;" vertex="1" parent="1">
      <mxGeometry x="370" y="160" width="300" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s2a1" value="- 开关: 零火版(小米/绿米 70-140元)&#xa;- 网关: 多模款(ZigBee+蓝牙Mesh)&#xa;- 传感器: 毫米波人在传感器&#xa;- 语音: 小爱音箱Pro&#xa;- 温控: 空调伴侣50元/VRF 800元" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#a8d08d;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="370" y="192" width="300" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="s2b" value="[灯具搭配方案]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#eaf5ea;strokeColor=#82b366;align=center;" vertex="1" parent="1">
      <mxGeometry x="370" y="306" width="300" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s2b1" value="方案一(推荐): 智能灯+智能开关&#xa;  易来/雷士/Lipro 调温调光调色&#xa;方案二: 普通灯+智能开关&#xa;  欧普/雷士 款式丰富 性价比高" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#a8d08d;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="370" y="338" width="300" height="84" as="geometry"/>
    </mxCell>

    <mxCell id="s2c" value="[避坑清单]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#eaf5ea;strokeColor=#82b366;align=center;" vertex="1" parent="1">
      <mxGeometry x="370" y="436" width="300" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s2c1" value="X 不买蓝牙Mesh 1.0(选2.0)&#xa;X 不买非米家原生设备&#xa;X 不买鸡肋设备(聚焦四大场景)&#xa;V 所有设备保留手动兜底" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#a8d08d;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
