    <!-- ========== Section 3 ========== -->
    <mxCell id="s3" value="三、核心场景专项" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;arcSize=15;" vertex="1" parent="1">
      <mxGeometry x="700" y="90" width="320" height="44" as="geometry"/>
