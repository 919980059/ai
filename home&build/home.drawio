    <mxCell id="s3sub" value="兼顾美观实用，规避联动失灵" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#d6b656;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="700" y="134" width="320" height="16" as="geometry"/>
