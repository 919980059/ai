    <mxCell id="s3a" value="[智能灯光]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fef9e7;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
      <mxGeometry x="700" y="160" width="320" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s3a1" value="- 无频闪 Ra&gt;=90 卧室2700-3000K&#xa;- 分区回路 走廊渐亮渐灭&#xa;- 智能灯保持开关常通&#xa;- 聚焦晨起/观影/离家模式" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#e8d590;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="700" y="192" width="320" height="84" as="geometry"/>
    </mxCell>

    <mxCell id="s3b" value="[智能窗帘]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fef9e7;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
      <mxGeometry x="700" y="290" width="320" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s3b1" value="- 静音&lt;=35dB 带手拉+限位调节&#xa;- 轨道误差&lt;=2mm 纱布帘距&gt;=5cm&#xa;- 电机端预留10cm检修空间&#xa;- 光线+时间双条件触发" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#e8d590;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="700" y="322" width="320" height="84" as="geometry"/>
    </mxCell>

    <mxCell id="s3c" value="[智能安防]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fef9e7;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
      <mxGeometry x="700" y="420" width="320" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="s3c1" value="- 必装: 门锁+摄像头+燃气水浸+门磁&#xa;- 进阶: 人体传感器+烟雾+离线网关&#xa;- 摄像头避隐私区 离地&gt;=2.5m&#xa;- 确保离线本地联动(断网仍告警)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#e8d590;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="700" y="452" width="320" height="84" as="geometry"/>
    </mxCell>

    <!-- ========== Section 4 ========== -->
    <mxCell id="s4" value="四、场景搭建与需求规划" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a2e;arcSize=15;" vertex="1" parent="1">
      <mxGeometry x="50" y="610" width="420" height="42" as="geometry"/>
